# Copia a .env y configura credenciales propias. Este archivo no contiene secretos reales.
# Variables de .env en su orden original.
COUCHDB_URL=http://app:replace-password@localhost:5984/tesis
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SQLITE_PATH=auth.sqlite
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIS_URL=redis://localhost:6379
CARBONE_URL=
CARBONE_TLS_INSECURE=false
CARBONE_API_KEY=
CARBONE_VIAJE_TEMPLATE_ID=
CARBONE_HISTORIA_TEMPLATE_ID=
FILE_STORAGE_ROOT=storage/uploads
FILE_STORAGE_PUBLIC_URL=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SUPPORTS_ACL=true
S3_PUBLIC_URL=
DATA_SCIENCE_API_URL=http://localhost:8000

# Variables adicionales de web y workers. Opcionales salvo que actives su servicio.
AGEMED_CATALOG_CRON="0 3 * * *"
AGEMED_CATALOG_URL=https://apiwww.agemed.gob.bo/api/listautcom
CARBONE_HISTORIA_TEMPLATE_PATH=
CARBONE_HISTORIA_TEMPLATE_URL=
DATA_SCIENCE_INTERNAL_TOKEN=
RAG_INDEX_CRON="15 */6 * * *"
SESSION_CLEANUP_CRON="15 * * * *"
AUDIT_CLEANUP_CRON="30 2 * * *"
AUDIT_RETENTION_YEARS=5
NODE_EXTRA_CA_CERTS=

# Servicio Python. Se puede configurar en data-science/.env.
# Valores vacíos de opciones con default se omiten para conservar el default del servicio.
# DS_LLM_PROVIDER=
# DS_OLLAMA_URL=
# DS_CHAT_MODEL=
# GROQ_API_KEY=
# DS_GROQ_BASE_URL=
# DS_TEMPERATURE=
# DS_REASONING_FORMAT=
# DS_REASONING_EFFORT=
# DS_EMBEDDING_MODEL=
# DS_STORAGE_DIR=
# DS_INTERNAL_TOKEN=
# DS_CORS_ORIGINS=

# Sincronización: una Raspberry y una nube; desactivada hasta completar la configuración.
# En Raspberry se exige HTTPS hacia la nube; secretos distintos de BETTER_AUTH_SECRET.
APP_ENVIRONMENT=cloud
SYNC_ENABLED=false
SYNC_NODE_ID=raspberry-01
SYNC_CLOUD_APP_URL=https://app.example.com
SYNC_CLOUD_COUCHDB_URL=https://couch.example.com/tesis
SYNC_CLOUD_COUCHDB_USERNAME=
SYNC_CLOUD_COUCHDB_PASSWORD=
SYNC_SHARED_SECRET=
SYNC_CONTROL_DB=tesis_sync_control
SYNC_INTERVAL_SECONDS=60

# Diagnóstico Node (no deshabilitar verificación TLS en sincronización).
# NODE_TLS_REJECT_UNAUTHORIZED=1

# Opcional: host exacto autorizado para HTTP sobre una red privada como NetBird.
# Vacío conserva HTTPS obligatorio. No desactiva la verificación TLS.
SYNC_TRUSTED_HTTP_HOST=

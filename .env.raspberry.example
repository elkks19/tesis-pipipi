# Copiar a .env.raspberry. Este archivo se usa con --env-file de Compose.
TESIS_IMAGE=elkks/tesis:latest
TESIS_DS_IMAGE=elkks/tesis-ds:latest
WEB_PORT=3000
WEB_BIND_ADDRESS=0.0.0.0
# Cambiar por el hostname/IP desde el que los usuarios acceden a la Raspberry.
BETTER_AUTH_URL=http://raspberrypi.local:3000
# Generar cada secreto independientemente: openssl rand -hex 32
BETTER_AUTH_SECRET=
COUCHDB_USER=tesis
# Hexadecimal, mínimo 32 caracteres; evita caracteres reservados de URL.
COUCHDB_PASSWORD=
DS_INTERNAL_TOKEN=

# Activar solo después de configurar la nube. El primer arranque necesita conexión.
SYNC_ENABLED=false
SYNC_NODE_ID=raspberry-01
SYNC_INTERVAL_SECONDS=60
SYNC_CLOUD_APP_URL=https://app.example.com
SYNC_CLOUD_COUCHDB_URL=https://couch.example.com/tesis
SYNC_CLOUD_COUCHDB_USERNAME=
SYNC_CLOUD_COUCHDB_PASSWORD=
# Mismo secreto de intercambio configurado en la nube, distinto de Better Auth.
SYNC_SHARED_SECRET=

DS_LLM_PROVIDER=groq
DS_CHAT_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
DS_OLLAMA_URL=http://host.docker.internal:11434
DS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HF_HUB_OFFLINE=0

# Reportes PDF: servicio Carbone externo, configurar si se van a generar.
CARBONE_URL=
CARBONE_API_KEY=
CARBONE_HISTORIA_TEMPLATE_ID=
CARBONE_VIAJE_TEMPLATE_ID=

# Carbone local: API privada de Docker; copiar plantillas a carbone/template.
CARBONE_IMAGE=carbone/carbone-ee:latest
CARBONE_LICENSE=
CARBONE_TLS_INSECURE=false
DS_GROQ_BASE_URL=https://api.groq.com/openai/v1
DS_MAX_COMPLETION_TOKENS=900
DS_TEMPERATURE=0.2
DS_REASONING_FORMAT=hidden
DS_REASONING_EFFORT=low

# Opcional: host exacto autorizado para HTTP sobre una red privada como NetBird.
# Vacío conserva HTTPS obligatorio. No desactiva la verificación TLS.
SYNC_TRUSTED_HTTP_HOST=

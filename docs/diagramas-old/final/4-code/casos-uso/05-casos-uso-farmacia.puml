@startuml
title Casos de uso - farmacia

left to right direction
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #172033
}

actor "Estudiante de farmacia" as EstudianteFarmacia
actor "Docente de farmacia" as DocenteFarmacia

rectangle "Planeacion de farmacia" {
  usecase "Acceder a farmacia" as UCAcceso
  usecase "Resolver viaje permitido" as UCResolverViaje
  usecase "Consultar inventario" as UCConsultar
  usecase "Agregar item de inventario" as UCAgregar
  usecase "Normalizar medicamento" as UCNormalizar
  usecase "Usar catalogo local" as UCCatalogo
  usecase "Actualizar cantidad planificada" as UCActualizar
}

EstudianteFarmacia --> UCAcceso
EstudianteFarmacia --> UCConsultar
EstudianteFarmacia --> UCAgregar
EstudianteFarmacia --> UCActualizar

DocenteFarmacia --> UCAcceso
DocenteFarmacia --> UCConsultar
DocenteFarmacia --> UCAgregar
DocenteFarmacia --> UCActualizar

UCAcceso .> UCResolverViaje : requiere
UCAgregar .> UCNormalizar : si es medicamento
UCNormalizar .> UCCatalogo : consulta
UCActualizar .> UCConsultar : parte de

@enduml

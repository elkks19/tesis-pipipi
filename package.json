{
  "name": "tesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca node --use-system-ca node_modules/next/dist/bin/next dev -p 5173",
    "build": "next build",
    "start": "croos-env NODE_OPTIONS=--use-system-ca node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "tunnel": "ngrok http 5173 --url integral-lemming-lately.ngrok-free.app",
    "worker:reportes": "cross-env NODE_OPTIONS=--use-system-ca node --use-system-ca scripts/reporte-historia-worker.mjs",
    "worker:catalogo": "cross-env NODE_OPTIONS=--use-system-ca node --use-system-ca scripts/catalogo-agemed-worker.mjs",
    "seed": "pnpm run seed:users && pnpm run seed:historias",
    "seed:historias": "cross-env NODE_OPTIONS=--use-system-ca node --use-system-ca scripts/seed-historias.mjs",
    "seed:primeros-pacientes": "cross-env NODE_OPTIONS=--use-system-ca node --use-system-ca scripts/seed-primeros-pacientes-historias.mjs",
    "seed:reset": "pnpm run seed:users && pnpm run seed:historias -- --reset-db && pnpm run seed:primeros-pacientes",
    "seed:users": "cross-env NODE_OPTIONS=--use-system-ca node --use-system-ca scripts/seed-users.mjs",
    "test": "pnpm run test:unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:unit": "pnpm run test:unit:ts && pnpm run test:unit:py",
    "test:unit:py": "cross-env PYTHONPATH=data-science data-science/venv/bin/python -m unittest discover -s data-science/tests -p '*_test.py'",
    "test:unit:ts": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@base-ui/react": "^1.8.0",
    "@openai/codex": "^0.142.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/better-sqlite3": "^7.6.13",
    "@whoicd/icd11ect": "^1.8.0",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.81.5",
    "carbone-sdk": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "flydrive": "^2.1.0",
    "lucide-react": "^1.47.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pouchdb": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "pouchdb-mapreduce": "^9.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pouchdb": "^6.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
